# Copy to a file outside git and export it, or pass --env-file.
# Do not put a private key in this file. Paper mode is the default.
# Live trading starts only when DRY_RUN=0, LIVE=1, and LIVE_CONFIRM equals the coin.

ENTROPY_ACCOUNT_ADDRESS=
ENTROPY_AGENT_SECRET_FILE=
ENTROPY_COIN=io:ANTH
ENTROPY_DRY_RUN=1
ENTROPY_LIVE=0
ENTROPY_LIVE_CONFIRM=
ENTROPY_ORDER_SIZE=
ENTROPY_MAX_POSITION=
ENTROPY_REFRESH_SECONDS=2
ENTROPY_REPRICE_BPS=5
ENTROPY_HALF_SPREAD_BPS=8
ENTROPY_SKEW_BPS=10
ENTROPY_MAX_BOOK_AGE_SECONDS=3
ENTROPY_MIN_REST_SECONDS=5
ENTROPY_MIN_NOTIONAL_USD=10
ENTROPY_MARK_DEVIATION_BPS=50
ENTROPY_STATE_FILE=.entropy-maker/state.json
ENTROPY_PAPER_EQUITY_USD=10000
ENTROPY_NETWORK=mainnet
ENTROPY_BOOK_SOURCE=rest
ENTROPY_AGENT_MIN_TTL_SECONDS=86400
ENTROPY_AGENT_NAME=
ENTROPY_LOG_LEVEL=INFO
